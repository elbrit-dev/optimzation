# ─────────────────────────────────────────────────────────────────────────────
# Elbrit One — environment variables (KEYS ONLY, no values)
#
# Copy to `.env.local` and fill in. `.env.local` overrides `.env` in Next.js.
# Both are gitignored; this file is not — never put real values here.
#
# NEXT_PUBLIC_* are INLINED INTO THE CLIENT BUNDLE AT BUILD TIME:
#   - they are public, so never put a secret behind that prefix
#   - changing one on Netlify requires a REDEPLOY, not just a restart
# Everything else is server-only (API routes, build scripts).
#
# Legend:  [req] required   [opt] optional / has a code default   [x] unused today
# Full explanation of every group: KT.md §13.
# ─────────────────────────────────────────────────────────────────────────────


# =============================================================================
# Firebase (client) — auth + Firestore
# =============================================================================
# Project: elbrit-sso-d01d9. Providers: Google + Phone.
# Firestore uses the NON-DEFAULT database named `elbrit`; that name is
# hardcoded in firebase.js / lib/firebase.js, not configured here.
# The web API key is public by design — netlify.toml already tells Netlify's
# secret scanner to ignore it (SECRETS_SCAN_OMIT_KEYS).
# Consumed by: firebase.js, lib/firebase.js, share/src/lib/firebase.js

# [req]
NEXT_PUBLIC_FIREBASE_API_KEY=
# [req]
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# [req]
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# [req]
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# [req]
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# [req]
NEXT_PUBLIC_FIREBASE_APP_ID=
# [opt] analytics only
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# [opt] read by share/ only
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=
# [x] present in .env today but NO code reads it
#     (FirebaseUI's phone provider builds its own reCAPTCHA)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=


# =============================================================================
# Plasmic — which published design the app loads
# =============================================================================
# "prod"        → only versions published with the `prod` tag in Studio
# "dev"/unset   → the latest publish of any tag (test sites)
# anything else → throws at import time (plasmic-init.js)
# NOTE: the loader's project id + token are HARDCODED in plasmic-init.js.
# The PLASMIC_PROJECT_* vars further down are used only by `npm run mcp`.

# [req] dev | prod
NEXT_PUBLIC_PLASMIC_TAG=


# =============================================================================
# Release guard — blocks accidental production builds
# =============================================================================
# scripts/release-guard.js runs before `next build`:
#   tag=dev                  → allowed
#   tag=prod + channel=prod  → allowed
#   tag=prod + anything else → BUILD BLOCKED (exit 1)

# [req on prod] set to `prod` to arm a live deploy
RELEASE_CHANNEL=
# [opt] alias for RELEASE_CHANNEL
NEXT_PUBLIC_RELEASE_CHANNEL=
# [opt] alias for NEXT_PUBLIC_PLASMIC_TAG
PLASMIC_SITE_TAG=


# =============================================================================
# Plasmic MCP server (`npm run mcp`) — local tooling only
# =============================================================================
# Lists Studio pages/components and does CMS CRUD. Not needed to run the app.

# [opt]
NEXT_PUBLIC_PLASMIC_PROJECT_ID=
# [opt]
NEXT_PUBLIC_PLASMIC_PROJECT_TOKEN=
# [opt] fallback for NEXT_PUBLIC_PLASMIC_PROJECT_ID
PLASMIC_PROJECT_ID=
# [opt] fallback for NEXT_PUBLIC_PLASMIC_PROJECT_TOKEN
PLASMIC_PROJECT_TOKEN=
# [opt] only for the cms_* tools
PLASMIC_CMS_ID=
# [opt] cms read
PLASMIC_CMS_PUBLIC_TOKEN=
# [opt] cms write
PLASMIC_CMS_SECRET_TOKEN=


# =============================================================================
# Novu (self-hosted at notify.elbrit.org) — SERVER side
# =============================================================================
# Consumed by: pages/api/novu/identify.js, pages/api/novu/trigger.js,
#              pages/api/onesignal/register-device.js
# Leaving NOVU_BACKEND_URL blank does NOT fall back to Novu Cloud — the code
# defaults to https://api.notify.elbrit.org.

# [req] server API key for the target Novu environment
NOVU_API_KEY=
# [opt] default: https://api.notify.elbrit.org
NOVU_BACKEND_URL=
# [req] shared secret ERPNext sends as the `x-webhook-secret` header when it
#       POSTs to /api/novu/trigger — without a match the route 401s
NOVU_TRIGGER_SECRET=


# =============================================================================
# Novu — CLIENT (the inbox widget)
# =============================================================================
# These have defaults in plasmic-init.js (NovuInbox prop defaults), so the bell
# renders without them — but they must point at the SAME Novu environment as
# NOVU_API_KEY or the inbox will be empty.

# [opt] Novu environment application identifier
NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=
# [opt] default: https://api.notify.elbrit.org
NEXT_PUBLIC_NOVU_BACKEND_URL=
# [opt] default: https://ws.notify.elbrit.org
NEXT_PUBLIC_NOVU_SOCKET_URL=


# =============================================================================
# OneSignal (web push) — no env var by design
# =============================================================================
# The app id is hardcoded in pages/_app.jsx and the worker lives at
# public/onesignal/OneSignalSDKWorker.js. The OneSignal REST key is stored in
# Novu's OneSignal integration, not in this app. Listed here so nobody hunts
# for a key that does not exist.


# =============================================================================
# Google Calendar OAuth
# =============================================================================
# Consumed by: pages/api/google-calendar/connect.js (server-side token exchange)

# [req if Calendar sync is enabled]
GOOGLE_CLIENT_ID=
# [req if Calendar sync is enabled] SERVER-ONLY — never prefix with NEXT_PUBLIC_
GOOGLE_CLIENT_SECRET=
# [opt] fallback origin for the OAuth redirect_uri; the callback page normally
#       sends the real window origin instead
APP_URL=


# =============================================================================
# ERP / GraphQL
# =============================================================================
# The live ERP endpoint and auth token are passed into components as PLASMIC
# PROPS (e.g. CalendarPage `erpUrl` / `authToken`) — NOT via env.
# The vars below are a convention in lib/graphql-endpoints.js that nothing
# imports today. It also discovers keys by ITERATING process.env, which does
# not work in client bundles — server-side only if it is ever revived.

# [x] pattern: NEXT_PUBLIC_GRAPHQL_ENDPOINT_<KEY>
# NEXT_PUBLIC_GRAPHQL_ENDPOINT_UAT=
# NEXT_PUBLIC_GRAPHQL_ENDPOINT_PROD=
# [x] pattern: NEXT_PUBLIC_GRAPHQL_AUTH_TOKEN_<KEY> — key must match the endpoint's
# NEXT_PUBLIC_GRAPHQL_AUTH_TOKEN_UAT=
# NEXT_PUBLIC_GRAPHQL_AUTH_TOKEN_PROD=
# [x] which <KEY> to use by default
# NEXT_PUBLIC_GRAPHQL_DEFAULT_ENDPOINT=


# =============================================================================
# Consumed by share/ (vendored from elbrit-dev/playground)
# =============================================================================

# [opt] Firestore collection holding saved GraphQL queries (default: gql)
NEXT_PUBLIC_GQL_COLLECTION=
# [opt] comma-separated allowlist for post-login redirects
NEXT_PUBLIC_ALLOWED_REDIRECT_ORIGINS=
# [opt] set to 1 to log the datatable context
NEXT_PUBLIC_DEBUG_TABLE_CONTEXT=


# =============================================================================
# Local dev / build misc
# =============================================================================

# [opt] dev server port (default 3000)
PORT=
# [opt] Netlify secret scanning on/off — netlify.toml already omits the
#       Firebase API key from the scan
SECRETS_SCAN_ENABLED=


# =============================================================================
# One-off migration script only
# =============================================================================
# scripts/import-storage-to-firestore.mjs, and only if Storage/Firestore rules
# require a signed-in user. Not needed to run or build the app.

# [opt]
FB_EMAIL=
# [opt]
FB_PASSWORD=
