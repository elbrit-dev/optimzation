# ─────────────────────────────────────────────────────────────────────────────
# Elbrit One — environment variables
#
# Only keys that are ACTUALLY READ by code (root + share/ + shared/) are listed.
# Verified by scanning every `process.env` reference in the repo.
# Anything deliberately left out is recorded at the bottom of this file.
#
# Copy to `.env.local` and fill in the values. `.env.local` overrides `.env`;
# both are gitignored. This file is committed — never put real values in it.
#
# NEXT_PUBLIC_* are INLINED INTO THE CLIENT BUNDLE AT BUILD TIME:
#   - public by definition, so never put a secret behind that prefix
#   - changing one on Netlify needs a REDEPLOY, not just a restart
# Everything else is server-only (API routes / build scripts).
# ─────────────────────────────────────────────────────────────────────────────


# =============================================================================
# REQUIRED — the app will not work correctly without these
# =============================================================================

# ── Firebase (auth + Firestore), project elbrit-sso-d01d9 ────────────────────
# Read by: firebase.js, lib/firebase.js, share/src/lib/firebase.js
# The root files have hardcoded fallbacks, but share/src/lib/firebase.js has
# NONE — leave these blank and every share/ page breaks.
# The web API key is public by design (netlify.toml already exempts it from
# Netlify's secret scanner).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAU7NbYC2FizLMT0HWJLWPTR0XkEn-xBXA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=elbrit-sso-d01d9.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=elbrit-sso-d01d9
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=elbrit-sso-d01d9.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=878677132537
NEXT_PUBLIC_FIREBASE_APP_ID=1:878677132537:web:c85dd96936d5ed1ecd4e28

# Firestore database name. This app uses the NON-DEFAULT database `elbrit`.
# The root files force that name in code; share/src/lib/firebase.js does NOT —
# it falls back to '(default)', which is empty. Set this to: elbrit
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=elbrit

# ── Plasmic: which published design the app loads ────────────────────────────
# dev (or unset) → latest publish of any tag   [test sites]
# prod           → only versions published with the `prod` tag in Studio
# any other value throws at import time (plasmic-init.js)
# The loader's project id + token are HARDCODED in plasmic-init.js, not here.
NEXT_PUBLIC_PLASMIC_TAG=dev

# ── Release guard (scripts/release-guard.js, runs before `next build`) ───────
# tag=dev → allowed | tag=prod + RELEASE_CHANNEL=prod → allowed
# tag=prod + anything else → BUILD BLOCKED.
# Only needed on the production deploy context.
# (The guard also accepts NEXT_PUBLIC_RELEASE_CHANNEL / PLASMIC_SITE_TAG as
#  aliases — we don't use them.)
RELEASE_CHANNEL=dev

# ── Novu (self-hosted, notify.elbrit.org) — server side ──────────────────────
# Read by: pages/api/novu/identify.js, pages/api/novu/trigger.js,
#          pages/api/onesignal/register-device.js
NOVU_API_KEY=989c52bc8e8ad2edda1fa7604c254000

# ── ERP credentials — login-help form (HR SOP) ───────────────────────────────
# Read by: lib/erpServer.js, via pages/api/hr/employee-lookup.js
#          and pages/api/hr/login-help.js
#
# NOTHING HERE IS REQUIRED. Every setting resolves prop → env → baked-in
# default, and the defaults already work: project "LoginIssue" (BUG-0002),
# assignee hr@elbrit.org, target ERP. Set a var here only to change the default
# for the whole deployment; for a single page, use the Plasmic props instead.
#
# WHY a service account and not the usual token: every other ERP call in the
# app rides on the PER-USER token Plasmic injects after login. The login-help
# form runs on the login page — before login — so no user token exists yet.
#
# BY DEFAULT THIS NEEDS NO NEW CREDENTIALS. It reuses the pair already on
# Netlify, matched by suffix:
#     NEXT_PUBLIC_GRAPHQL_ENDPOINT_<TARGET>
#     NEXT_PUBLIC_GRAPHQL_AUTH_TOKEN_<TARGET>
# ERP_TARGET picks which. Default ERP (production) — set ERP_TARGET=UAT on the
# UAT site, or its login tickets land in live ERP.
ERP_TARGET=ERP
#
# Those two are NEXT_PUBLIC_ by name but are NOT in the client bundle: Next only
# inlines a NEXT_PUBLIC_ var where client code references process.env.NAME
# literally, and nothing does (lib/graphql-endpoints.js iterates process.env
# dynamically — never inlined, and dead code besides). Verified by grepping
# .next/static: no ERP host appears there. Reading them server-side exposes
# nothing new. If a component ever references one literally, that write token
# starts shipping to browsers — switch to the dedicated pair below.
#
# OPTIONAL OVERRIDE — set BOTH or NEITHER (half-set throws, so a partial
# override can't silently fall back to the shared token). Use these to give the
# login-help flow its own narrower service account:
#   Format: <api_key>:<api_secret>, from ERP User → API Access → Generate Keys.
#   Narrowest role that can read Employee and create + assign Task. Nothing else.
# SERVER-ONLY — never prefix these with NEXT_PUBLIC_.
ERP_BASE_URL=
ERP_API_TOKEN=

# Where login-help tickets get filed. Accepts a project ID (BUG-0002) OR the
# human project_name (LoginIssue) — whichever HR quotes. Defaults to LoginIssue.
# If it doesn't resolve, tickets are still created and still assigned, just
# unfiled (losing the ticket would be worse than misfiling it) + a logged warning.
ERP_LOGIN_HELP_PROJECT=

# ERP user the tickets are assigned to. Defaults to hr@elbrit.org.
# Must be an @elbrit.org address.
ERP_LOGIN_HELP_ASSIGNEE=

# ── Google Calendar OAuth (only if Calendar sync is enabled) ─────────────────
# Read by: pages/api/google-calendar/connect.js (server-side token exchange)
GOOGLE_CLIENT_ID=509894256351-70n154bekl76g0gcfanddh4nvqcqukv1.apps.googleusercontent.com
# SERVER-ONLY — never prefix this with NEXT_PUBLIC_
GOOGLE_CLIENT_SECRET=


# =============================================================================
# OPTIONAL — code defaults exist; set to override
# =============================================================================

# Firebase Analytics. Omit and analytics is simply skipped.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-2REFK80W2D

# Novu server API base. Default: https://api.notify.elbrit.org
# Blank does NOT fall back to Novu Cloud.
NOVU_BACKEND_URL=https://api.notify.elbrit.org

# Novu inbox widget (client). These have defaults in plasmic-init.js, but they
# must point at the SAME Novu environment as NOVU_API_KEY or the bell is empty.
# Defaults: <prod app identifier> / api.notify.elbrit.org / ws.notify.elbrit.org
NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=K3rsfIP_eYvg
NEXT_PUBLIC_NOVU_BACKEND_URL=https://api.notify.elbrit.org
NEXT_PUBLIC_NOVU_SOCKET_URL=https://ws.notify.elbrit.org

# Fallback origin for the Google OAuth redirect_uri. The callback page normally
# sends the real window origin, so this is only a safety net.
APP_URL=https://app.elbrit.org || https://app-uat.elbrit.org

# Dev server port. Default 3000.
PORT=


# For other extra variable please check with the Netify env varaibles